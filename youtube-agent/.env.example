# ai-tuber — copy to .env and fill in. Only ANTHROPIC_API_KEY is required.

# =============================================================================
# Claude (required)
# =============================================================================

# Get one at https://console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# Which model writes the research, script, metadata and thumbnails.
AI_MODEL=claude-opus-5

# How hard the model works per call: low | medium | high | xhigh | max.
# "high" is the sweet spot. "max" costs noticeably more for a small gain here.
AI_EFFORT=high

# Ceiling per call. A 10-minute script lands around 4-6k tokens, so the default
# leaves plenty of headroom.
AI_MAX_TOKENS=32000

# Per-call timeout. Long scripts at high effort can run for several minutes.
AI_TIMEOUT_MS=600000

# Let Claude search the live web while researching topics. Adds cost per run,
# but catches what happened after the model's training cutoff.
ENABLE_WEB_SEARCH=false
WEB_SEARCH_MAX_USES=6

# =============================================================================
# Your channel — the more you fill in, the less generic the output
# =============================================================================

CHANNEL_NAME=
CHANNEL_NICHE=
CHANNEL_AUDIENCE=curious beginners who want a straight answer fast
CHANNEL_TONE=clear, energetic and concrete — no filler, no clickbait that the video does not pay off

# Language for everything the viewer sees: narration, titles, description,
# on-screen text. Use a short language tag: en, ur, hi, ar, es...
# B-roll search phrases stay English so stock sites can match them.
CONTENT_LANGUAGE=en

# =============================================================================
# Video shape
# =============================================================================

# Target runtime in seconds. The script's word budget is derived from this.
TARGET_DURATION_SEC=480

# Narration pace used to turn word counts into timings.
# 2.6 words/sec ≈ 156 wpm, a normal energetic delivery. Slow yours down to ~2.2
# if you speak deliberately, or if you are recording in Urdu or Hindi.
WORDS_PER_SECOND=2.6

# How many topic ideas `ai-tuber topics` and `ai-tuber make` generate.
TOPIC_COUNT=8

# =============================================================================
# Optional integrations — everything still works without these
# =============================================================================

# YouTube Data API v3 key. Lets topic research see what is already ranking:
# real titles, view counts and views/day instead of the model's recollection.
# https://console.cloud.google.com → enable "YouTube Data API v3" → create key.
YOUTUBE_API_KEY=

# Pexels key (free) for downloading stock photos into each scene's b-roll slot.
# Without it the search phrases are written to shotlist.md to source by hand.
# https://www.pexels.com/api/
PEXELS_API_KEY=

# Voiceover. "none" means you record the narration yourself.
TTS_PROVIDER=none
ELEVENLABS_API_KEY=
# Default is ElevenLabs' public "Rachel" voice. Pick your own in their voice lab.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_multilingual_v2 handles Urdu and Hindi; eleven_turbo_v2_5 is cheaper for English.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# =============================================================================
# Output
# =============================================================================

# Each run writes a dated folder under here.
OUTPUT_DIR=./out

# Stock photos to pull per scene. 0 disables downloading.
BROLL_PER_SCENE=2

# =============================================================================
# Logging
# =============================================================================

LOG_LEVEL=info
LOG_PRETTY=true
