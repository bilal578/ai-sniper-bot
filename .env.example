# ============================================================================
#  ai-sniper-bot configuration
#  Copy to `.env` and fill in. Every value below is optional except
#  RPC_HTTP_URL — the defaults shown are what the bot uses if you omit a line.
# ============================================================================

# ---------------------------------------------------------------------------
# NETWORK
# ---------------------------------------------------------------------------
# A public RPC will rate-limit you out of every good entry. Use a paid endpoint
# (Helius, QuickNode, Triton) for anything beyond testing.
RPC_HTTP_URL=https://api.mainnet-beta.solana.com
# Websocket endpoint for the log subscriptions. Derived from the HTTP url if unset.
RPC_WS_URL=

JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1
# Optional — raises your Jupiter rate limits.
JUPITER_API_KEY=

# ---------------------------------------------------------------------------
# WALLET
# ---------------------------------------------------------------------------
# Base58 secret key (Phantom → Export Private Key) or a JSON array of 64 bytes.
# Use a dedicated burner wallet funded with only what you can afford to lose.
WALLET_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# MODE — three independent switches must all be set before real funds move
# ---------------------------------------------------------------------------
DRY_RUN=true
CONFIRM_LIVE=false

# ---------------------------------------------------------------------------
# POSITION SIZING & RISK
# ---------------------------------------------------------------------------
BUY_AMOUNT_SOL=0.05
MAX_CONCURRENT_POSITIONS=3
# Trading halts for the rest of the UTC day once realised losses reach this.
MAX_DAILY_LOSS_SOL=0.5
MAX_TRADES_PER_HOUR=10
# SOL always kept back so you can still pay fees to exit.
MIN_WALLET_RESERVE_SOL=0.02

# ---------------------------------------------------------------------------
# EXECUTION
# ---------------------------------------------------------------------------
# New pools move violently; tight slippage simply means the fill never lands.
BUY_SLIPPAGE_BPS=1500
SELL_SLIPPAGE_BPS=2500
# 0 = let Jupiter estimate the compute-unit price dynamically, capped by
# MAX_PRIORITY_FEE_SOL below. Set a non-zero value to pin it yourself.
PRIORITY_FEE_MICRO_LAMPORTS=0
MAX_PRIORITY_FEE_SOL=0.005
TX_CONFIRM_TIMEOUT_MS=60000
# Extra buy attempts after the first fails. Each attempt re-quotes.
# Exits always get their own fixed retry budget, independent of this.
MAX_BUY_RETRIES=2

# ---------------------------------------------------------------------------
# EXIT STRATEGY
# ---------------------------------------------------------------------------
TAKE_PROFIT_PCT=80
STOP_LOSS_PCT=35
TRAILING_STOP_PCT=25
MAX_HOLD_MINUTES=30
PRICE_POLL_INTERVAL_MS=5000
# Sell this share of the position at the take-profit target and let the rest
# ride the trailing stop. Set to 0 to always exit the full position at target.
PARTIAL_TP_PCT=50

# ---------------------------------------------------------------------------
# SAFETY FILTERS
# ---------------------------------------------------------------------------
MIN_LIQUIDITY_SOL=5
MAX_LIQUIDITY_SOL=5000
MAX_TOP_HOLDER_PCT=25
MAX_TOP10_HOLDER_PCT=60
# A live mint authority = unlimited printing. A live freeze authority = the
# deployer can stop you selling. Leave both on unless you know why you are not.
REQUIRE_MINT_AUTHORITY_REVOKED=true
REQUIRE_FREEZE_AUTHORITY_REVOKED=true
# Maximum Token-2022 transfer fee to tolerate, as a percentage. Plain SPL
# mints cannot carry a fee at all and always pass. A high fee is a honeypot:
# the mint taxes the transfer that sells your position.
MAX_BUY_TAX_PCT=5
BLACKLISTED_MINTS=
BLACKLISTED_DEPLOYERS=

# ---------------------------------------------------------------------------
# AI ANALYSIS
# ---------------------------------------------------------------------------
ENABLE_AI_ANALYSIS=true
ANTHROPIC_API_KEY=
# Haiku is the right default: sniping is latency-bound, and the deterministic
# checks have already done the heavy lifting by the time the model is asked.
AI_MODEL=claude-haiku-4-5-20251001
AI_MIN_SCORE=65
AI_TIMEOUT_MS=8000
# false = an unreachable model blocks the trade. Keep it false.
AI_FAIL_OPEN=false

# ---------------------------------------------------------------------------
# DISCOVERY
# ---------------------------------------------------------------------------
WATCH_RAYDIUM=true
WATCH_PUMPFUN=true
MAX_TOKEN_AGE_SECONDS=120

# ---------------------------------------------------------------------------
# OPS
# ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
DATA_DIR=./data
